{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "machine-part",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "machine-part-artifacts" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "machine-part",
      "database_id": "REPLACE_ME"
    }
  ],
  "workflows": [
    {
      "name": "machine-part-pipeline",
      "binding": "CAD_PIPELINE",
      "class_name": "CadPipelineWorkflow"
    }
  ],
  "containers": [
    {
      "class_name": "CadContainer",
      "image": "./services/cad/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CAD_CONTAINER", "class_name": "CadContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CadContainer"] }
  ],
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 10000
  },
  "routes": [
    { "pattern": "ikun.homes", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "vars": {
    "MINIMAX_CHAT_URL": "https://api.minimax.io/v1/text/chatcompletion_v2",
    "MINIMAX_CHAT_PATH": "/text/chatcompletion_v2",
    "MINIMAX_MODEL": "MiniMax-M3"
  }
}
